# ==============================================================================
# JUSPAY Payment Automation Challenge - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
APP_NAME="JUSPAY Payment Gateway Simulator"
APP_VERSION=0.1.0
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Database Configuration (PostgreSQL)
# Note: Host port is mapped to 5433 in docker-compose.yml to avoid conflicts with default 5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=juspay_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5433/juspay_db

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Frontend Configuration
NEXT_PUBLIC_APP_NAME="JUSPAY Gateway"
NEXT_PUBLIC_API_URL=http://localhost:8001
PORT=3001

# OTP Security & Cryptography Configuration
# Replace with a cryptographically random 32+ character secret before running
OTP_SECRET_KEY=replace_with_a_secure_random_hmac_secret_key
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3

# Email Verification & SMTP Configuration (Local Mailpit: host=localhost, port=1025)
EMAIL_VERIFICATION_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=lifeflow4u.support@gmail.com
SMTP_PASSWORD=iilt hwlu nxzm mpyq
SMTP_FROM_EMAIL=lifeflow4u.support@gmail.com
SMTP_FROM_NAME=Stickora Store
SMTP_USE_TLS=True
SMTP_USE_SSL=False

