# ==============================================================================
# JUSPAY Payment Automation Challenge - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
APP_NAME="JUSPAY Payment Gateway Simulator"
APP_VERSION=0.1.0
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Database Configuration (PostgreSQL)
# Note: Host port is mapped to 5433 in docker-compose.yml to avoid conflicts with default 5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=juspay_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5433/juspay_db

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Frontend Configuration
NEXT_PUBLIC_APP_NAME="JUSPAY Gateway"
NEXT_PUBLIC_API_URL=http://localhost:8001
PORT=3001

# OTP Security & Cryptography Configuration
# Replace with a cryptographically random 32+ character secret before running
OTP_SECRET_KEY=replace_with_a_secure_random_hmac_secret_key
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3

# Email Verification & SMTP Configuration (Local Mailpit: host=localhost, port=1025)
EMAIL_VERIFICATION_ENABLED=True
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=no-reply@stickora.local
SMTP_FROM_NAME=Stickora Store
SMTP_USE_TLS=False
SMTP_USE_SSL=False

# Experimental WhatsApp Integration (BerryProtocol WhatsApp Web Sidecar)
WHATSAPP_PROVIDER=berryprotocol
WHATSAPP_ENABLED=true
WHATSAPP_EXPERIMENTAL=true
WHATSAPP_SENDER_NAME=Stickora Store
WHATSAPP_SESSION_ID=stickora_berry_session
WHATSAPP_SESSION_PATH=./data/berry_auth
WHATSAPP_DATABASE_PATH=./data/berry_store.db
WHATSAPP_META_FILE=./data/whatsapp_session.json
WHATSAPP_SERVICE_HOST=127.0.0.1
WHATSAPP_SERVICE_PORT=8002
WHATSAPP_SERVICE_URL=http://127.0.0.1:8002
WHATSAPP_INTERNAL_API_KEY=replace_with_a_secure_random_internal_key
WHATSAPP_ADMIN_KEY=replace_with_a_secure_random_merchant_admin_key
WHATSAPP_DISPATCH_ENABLED=true
WHATSAPP_AUTO_CONNECT=true

# Payment Provider Selection ('simulated' or 'paytm')
PAYMENT_PROVIDER=simulated

# Official Paytm Payment Gateway Sandbox Configuration (Staging)
PAYTM_MID=your_paytm_staging_mid
PAYTM_MERCHANT_KEY=your_paytm_staging_merchant_key
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail
PAYTM_CALLBACK_URL=http://localhost:8001/api/v1/payments/paytm/callback
PAYTM_ENVIRONMENT=staging

# ==============================================================================
# PayPilot Slow Motion Browser Automation Configuration
# ==============================================================================
BROWSER_ACTION_DELAY_MS=1500
BROWSER_CLICK_DELAY_MS=2000
BROWSER_NAVIGATION_DELAY_MS=2000
BROWSER_PRODUCT_ADDED_DELAY_MS=2500
BROWSER_CHECKOUT_DELAY_MS=2000
BROWSER_ORDER_CREATED_DELAY_MS=3000
BROWSER_PAYTM_PRE_DELAY_MS=2000
BROWSER_PAYMENT_VERIFIED_DELAY_MS=3000




